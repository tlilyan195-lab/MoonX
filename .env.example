# Trading Signal Bot — environment template
# Copy to .env and fill values. NEVER commit .env.

# --- Locked providers (ÉTAPE 5 V1) ---
# D1 market: Dukascopy FX/XAU + Binance crypto (public; no key required)
# D2 news:   JBlanked MQL5 calendar (locked)
MARKET_DATA_PROVIDER=dukascopy_binance
ECONOMIC_CALENDAR_PROVIDER=jblanked

# --- Data providers (READ-ONLY keys only) ---
# Do NOT use keys with trade / order / withdraw / transfer permissions.
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
ECONOMIC_CALENDAR_API_KEY=

# --- Telegram alerts (production / paper notify) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- App ---
LOCAL_TZ=Europe/Paris
DATABASE_URL=sqlite:///./data/signals.db
LOG_LEVEL=INFO

# Modes: backtest | calibrate | oos_eval | paper | live_signals
# ÉTAPE 5 sanity: use backtest/calibrate paths only — do NOT run oos_eval yet.
APP_MODE=backtest

# --- Economic calendar keys (read-only) ---
# Leave unused providers empty. Do NOT invent historical events.

FINNHUB_API_KEY=

# QuantGist — BLOCKED_AUTH (do not pay / do not regenerate keys for now)
QUANTGIST_API_KEY=

# FMP — BLOCKED_ENTITLEMENT (402). NO_AUTO payment.
FMP_API_KEY=

# JBlanked — LOCKED D2 for NEWS GATE V1. READ-ONLY.
# Profile → API key. Docs: https://www.jblanked.com/news/api/docs/calendar/
# Free = 1 request/day. Never paste the key in chat.
# Build: python3 scripts/build_d1d2_snapshot.py
# Sanity: python3 scripts/run_train_val_sanity.py
JBLANKED_API_KEY=
