# Trading Signal Bot — environment template
# Copy to .env and fill values. NEVER commit .env.

# --- Data providers (READ-ONLY keys only) ---
# Do NOT use keys with trade / order / withdraw / transfer permissions.
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
ECONOMIC_CALENDAR_API_KEY=

# Provider selection remains open (D1/D2) until quality comparison.
# MARKET_DATA_PROVIDER=placeholder
# ECONOMIC_CALENDAR_PROVIDER=placeholder

# --- Telegram alerts (production / paper notify) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- App ---
LOCAL_TZ=Europe/Paris
DATABASE_URL=sqlite:///./data/signals.db
LOG_LEVEL=INFO

# Modes: backtest | calibrate | oos_eval | paper | live_signals
APP_MODE=backtest

# --- Economic calendar (read-only; interchangeable) ---
# Required only if news blackout gate is enabled for TRAIN/VAL.
# Leave empty to skip; do NOT invent historical events.
FINNHUB_API_KEY=

# QuantGist free-plan pilot (ÉTAPE 5.1B′). READ-ONLY. Never paste the key in chat.
# Status: BLOCKED_AUTH — do not pay / do not regenerate keys for now.
# Create at https://quantgist.com/signup → dashboard/keys → put value here only.
QUANTGIST_API_KEY=

# FMP Free Basic — NEWS GATE pilot (ÉTAPE 5.1). READ-ONLY.
# Status: BLOCKED_ENTITLEMENT (HTTP 402 Restricted Endpoint on Free). NO_AUTO payment.
# Signup: https://site.financialmodelingprep.com/register → dashboard API key.
FMP_API_KEY=

# JBlanked Free Calendar — next NEWS GATE pilot (ÉTAPE 5.1). READ-ONLY. No payment.
# Profile → API key. Docs: https://www.jblanked.com/news/api/docs/calendar/
# Free = 1 request/day (docs). Never paste the key in chat.
# Put value here only, then run: python3 scripts/jblanked_free_pilot_gate.py
JBLANKED_API_KEY=
